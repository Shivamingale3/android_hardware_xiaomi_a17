soong_config_module_type {
    name: "xiaomi_hardware_biometrics_config_default",
    module_type: "cc_defaults",
    config_namespace: "XIAOMI_BIOMETRICS_FINGERPRINT",
    bool_variables: [
        "RUN_32BIT",
    ],
    value_variables: [
        "IMPL_VER",
    ],
    properties: [
        "compile_multilib",
        "cppflags",
    ],
}

xiaomi_hardware_biometrics_config_default {
    name: "xiaomi_hardware_biometrics_config_default",

    soong_config_variables: {
        RUN_32BIT: {
            conditions_default: {
                compile_multilib: "64",
            },
            compile_multilib: "prefer32",
        },
        IMPL_VER: {
            cppflags: ["-DIMPL_%s"],
        },
    },
}

cc_library_static {
    name: "libudfpshandlerfactory",
    srcs: ["UdfpsHandler.cpp"],
    vendor: true,
    header_libs: ["xiaomifingerprint_headers"],
    defaults: ["xiaomi_hardware_biometrics_config_default"],
}

cc_library_headers {
    name: "xiaomifingerprint_headers",
    export_include_dirs: ["include"],
    vendor: true,
    header_libs: ["libhardware_headers"],
    export_header_lib_headers: ["libhardware_headers"],
}

// libudfps_extension.xiaomi removed for PenguinOS: it is a system (SurfaceFlinger) library
// but needs sde_drm.h from device_kernel_headers, which AOSPA only provides for vendor.
// miatoll has a side-mounted fingerprint sensor (no UDFPS), so it is unused. Restore it
// (with a system-side kernel headers lib) for a UDFPS device.
